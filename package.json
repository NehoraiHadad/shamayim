{
  "name": "shamayim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "test:pixels": "node e2e/scene.pixels.mjs",
    "test:land-light": "node --experimental-strip-types e2e/landLighting.mjs && node --experimental-strip-types e2e/buildingLight.mjs && node --experimental-strip-types e2e/skyBase.mjs",
    "test:perf": "node e2e/scene.perf.mjs"
  },
  "dependencies": {
    "@fontsource/assistant": "^5.3.0",
    "@fontsource/frank-ruhl-libre": "^5.3.0",
    "@fontsource/karantina": "^5.3.0",
    "astronomy-engine": "^2.1.19",
    "geotiff": "^2.1.3",
    "maplibre-gl": "^5.24.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satellite.js": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
