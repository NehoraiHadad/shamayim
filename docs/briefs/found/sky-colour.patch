+import { smoothstep } from '../../domain/smoothstep'
+import { pinked } from '../../world/afterglow'
+import { solarBeam } from '../../world/sceneLight'
+import type { CloudLayer, RGB, WorldState } from '../../world/types'
+import { REF_BEAM, SUN_TO_SKY } from './landIrradiance'
+import { linearLuminance } from './landRadiance'
+import { DAY_CLOUD_DHI_GAIN } from './landSkyIrradiance'
+import { mixRgb, toLinear, toSrgb } from './tone'
+
+/*
+ * The sun's beam where a cloud stands, and the tone it gives the cloud: light ADDED to the body's own (sky) light. Pure.
+ */
+const WHITE: RGB = [1, 1, 1]
+const RAD = Math.PI / 180
+
+/** Clear-sky diffuse illuminance (IES Handbook: 0.8 + 15.5 √sin h klx) against its value at the land's reference, 38°. */
+const diffuseAt = (altitude: number) => (0.8 + 15.5 * Math.sqrt(Math.max(0, Math.sin(altitude * RAD)))) / (0.8 + 15.5 * Math.sqrt(Math.sin(38 * RAD)))
+/** At a low sun the lit cloud round a layer lights it in turn: the least share a deck under a low sun takes of its colour. */
+const RELAYED = 0.35
+
+/** The beam at the layer's height: its colour (linear transmission encoded once, the eye partly adapted) and its light against the sky's. */
+export function cloudBeam(world: WorldState, layer: CloudLayer): { rgb: RGB; ratio: number; relayed: number } {
+  const altitude = world.bodies.sun.altitude
+  const field = world.cloudField?.field.layers.find(({ lattice }) => lattice === layer.level)
+  const zKm = field ? field.baseKm + field.meanVKm / 2 : layer.baseM / 1000
+  const { transmission, strength } = solarBeam(Math.max(0, altitude), world.air, zKm)
+  const bright = Math.max(...transmission)
+  const colour = pinked(transmission.map((v) => toSrgb(v / bright)) as unknown as RGB, altitude)
+  // Below the horizon the beam leaves the layer as Earth's shadow climbs past it (`litUnderside`).
+  const reached = altitude > 0 ? 1 : layer.litUnderside
+  return {
+    rgb: mixRgb(colour, WHITE, 0.25 + 0.45 * smoothstep(6, 40, altitude)),
+    ratio: reached * SUN_TO_SKY * Math.min(1.15, strength / REF_BEAM) / (diffuseAt(altitude) * (1 + DAY_CLOUD_DHI_GAIN * world.light.diffuse)),
+    relayed: RELAYED * layer.litUnderside,
+  }
+}
+
+/**
+ * A body in its own sky light with the sun's added, `through` the cloud above and the air between: the mean of the two lights
+ * by their shares (the eye's exposure follows), never darker than the body (light is only added).
+ */
+export function litTone(body: RGB, light: { rgb: RGB; ratio: number; relayed: number }, through: number, fade: number): RGB {
+  const beam = light.ratio * through
+  const share = (1 - fade) * Math.max(beam / (1 + beam), light.relayed)
+  const own = body.map(toLinear) as [number, number, number]
+  const both = own.map((c, i) => c + share * (toLinear(light.rgb[i]) - c)) as [number, number, number]
+  const kept = Math.max(0, linearLuminance(own) - linearLuminance(both))
+  return both.map((c) => toSrgb(c + kept)) as unknown as RGB
+}
