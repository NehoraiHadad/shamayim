@@ -0,0 +1,62 @@
+import { beforeAll, describe, expect, it } from 'vitest'
+import { loadPlaces, stubPublicFetch, worldInput, type LoadedPlace } from '../../test/sceneWorld'
+import * as scenePlaces from '../../test/scenePlaces'
+import type { Place } from '../../config/place'
+import type { WorldInput } from '../../world/types'
+import { makeWorldBuilder } from '../../world/world'
+import { solarBeam, sunLight } from '../../world/sceneLight'
+import { litTone } from './cloudBeam'
+import { cloudLayersOf } from './cloudLayers'
+import { labOf, toSrgb } from './tone'
+import type { LayerOf, RGB } from './types'
+
+const box = { width: 375, skyHeight: 428, landTop: 300, landHeight: 128, dpr: 2 }
+const PLACES = ['haifa', 'neve-zohar', 'ramon-crater']
+let loaded: Map<string, LoadedPlace>
+beforeAll(async () => {
+  stubPublicFetch()
+  const all = (Object.values(scenePlaces) as unknown[]).flat().filter((p): p is Place => !!p && typeof p === 'object' && 'id' in p)
+  loaded = await loadPlaces(PLACES.map((id) => all.find((p) => p.id === id)!))
+}, 120_000)
+
+function sheets(id: string, at: string, over: Partial<WorldInput> = {}) {
+  const world = makeWorldBuilder()({ ...worldInput(loaded.get(id)!, at), ...over })
+  return cloudLayersOf(world, box).filter((l): l is LayerOf<'cloudSheet'> => l.kind === 'cloudSheet')
+}
+const hue = (rgb: RGB) => { const { a, b } = labOf(rgb); return { h: (Math.atan2(b, a) * 180 / Math.PI + 360) % 360, c: Math.hypot(a, b) } }
+
+describe('the sun on a cloud', () => {
+  it('lightens a sheet and never turns it olive, straw or dark red', () => {
+    for (const [id, at] of [['haifa', '2026-11-17T15:30'], ['neve-zohar', '2026-11-17T16:00'], ['haifa', '2026-11-17T16:30']]) {
+      for (const { lit, body, id: layer } of sheets(id, at)) {
+        expect(labOf(lit).l, `${id} ${at} ${layer}`).toBeGreaterThanOrEqual(labOf(body).l - 0.002)
+        const { h, c } = hue(lit)
+        if (c > 0.02) expect(h < 92 || h > 240, `${id} ${at} ${layer} hue ${h.toFixed(0)} chroma ${c.toFixed(3)}`).toBe(true)
+      }
+    }
+  })
+
+  it('reddens with the air above the cloud, along the true hue of sunlight', () => {
+    const air = { visibilityKm: 12.4 }
+    const beam = (z: number) => { const t = solarBeam(11.95, air, z).transmission; return t.map((v) => toSrgb(v / Math.max(...t))) as unknown as RGB }
+    expect(Math.abs(hue(beam(0)).h - 70)).toBeLessThan(6) // spectral truth 70° (3008 K), the disc's tone map 96°
+    expect(beam(4)[2]).toBeGreaterThan(beam(0)[2])
+    expect(sunLight(11.95, air).rgb[1]).toBeGreaterThan(0.85) // the disc's own look is the owner's: unchanged
+  })
+
+  it('only adds light', () => {
+    const grey: RGB = [0.74, 0.77, 0.8]
+    for (const ratio of [0, 0.2, 1, 8]) for (const rgb of [[1, 0.4, 0.3], [1, 0.9, 0.7]] as RGB[]) {
+      expect(labOf(litTone(grey, { rgb, ratio, relayed: 0 }, 1, 0)).l).toBeGreaterThanOrEqual(labOf(grey).l - 0.03)
+    }
+  })
+
+  it('lets dust fade a deck into the dust sky (no pale deck with brown gaps)', () => {
+    const dust = { pm10: 400, dust: 400, visibilityKm: 3 } as unknown as WorldInput['forced']
+    for (const sheet of sheets('ramon-crater', '2026-11-17T15:00', { forced: dust })) {
+      expect(sheet.through, sheet.id).toBeDefined()
+      expect(Math.max(...sheet.through!), sheet.id).toBeLessThan(sheet.lattice === 'low' ? 0.65 : 0.25)
+    }
+    for (const sheet of sheets('haifa', '2026-11-17T15:30')) expect(sheet.through).toBeUndefined()
+  })
+})
