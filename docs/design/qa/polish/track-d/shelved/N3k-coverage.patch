diff --git a/src/scene/model/cloudSheetCoverage.ts b/src/scene/model/cloudSheetCoverage.ts
new file mode 100644
index 0000000..d306909
--- /dev/null
+++ b/src/scene/model/cloudSheetCoverage.ts
@@ -0,0 +1,57 @@
+export function neighbourDelta(values: number[], i: number, col: number, cols: number, size: number) {
+  const center = values[i]
+  return Math.max(
+    col ? Math.abs(center - values[i - 1]) : 0,
+    col + 1 < cols ? Math.abs(center - values[i + 1]) : 0,
+    i >= cols ? Math.abs(center - values[i - cols]) : 0,
+    i + cols < size ? Math.abs(center - values[i + cols]) : 0,
+  )
+}
+
+export function coverageOrder(values: number[], i: number, col: number, cols: number, size: number) {
+  const delta = neighbourDelta(values, i, col, cols, size)
+  // N3k's half-opacity edge gets three strata. Below a byte of opacity
+  // variation, keep the centre sample at the painter's precision.
+  return delta > 0.5 ? 3 : delta > 1 / 255 ? 2 : 0
+}
+
+// Midpoint quadrature in equal-area strata of the projected deck footprint.
+// The footprint ends midway between adjacent rays, or at the view boundary.
+export function coverageSampler(
+  ranges: number[], east: number[], north: number[], slant: number[],
+  angularStep: number, depthAt: (x: number, y: number) => number,
+) {
+  const orders = [2, 3].map(count => {
+    const directions = east.map((e, col) => {
+      const min = col === 0 ? 0 : -0.5, max = col === east.length - 1 ? 0 : 0.5
+      const n = north[col]
+      return Array.from({ length: count }, (_, i) => {
+        const angle = (min + (max - min) * (i + 0.5) / count) * angularStep
+        const c = Math.cos(angle), s = Math.sin(angle)
+        return [e * c + n * s, n * c - e * s]
+      }).flat()
+    })
+    const radii = ranges.map((range, row) => {
+      const inner = (range + (ranges[row - 1] ?? range)) / 2
+      const outer = (range + (ranges[row + 1] ?? range)) / 2
+      const innerArea = inner * inner
+      const areaStep = (outer * outer - innerArea) / count
+      return Array.from({ length: count }, (_, i) => Math.sqrt(innerArea + areaStep * (i + 0.5)))
+    })
+    return { directions, radii }
+  })
+  return (row: number, col: number, count: 2 | 3) => {
+    const angles = orders[count - 2].directions[col]
+    const radii = orders[count - 2].radii[row]
+    const multiplier = slant[row]
+    let transmission = 0
+    for (let i = 0; i < angles.length; i += 2) {
+      const e = angles[i], n = angles[i + 1]
+      for (let j = 0; j < count; j++) {
+        const r = radii[j]
+        transmission += Math.exp(-depthAt(r * e, r * n) * multiplier)
+      }
+    }
+    return 1 - transmission / (count * count)
+  }
+}
