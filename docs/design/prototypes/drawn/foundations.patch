new file mode 100644
index 00000000..55f15dec
--- /dev/null
+++ b/src/scene/model/cloudSheetSeen.ts
@@ -0,0 +1,110 @@
+import { seeded } from '../../data/landmarks/hash'
+import { smoothstep } from '../../world/field/genus'
+import { altitudeOf } from '../../world/field/project'
+import { kernel } from '../../world/field/rasterNodes'
+import type { FieldCell } from '../../world/field/types'
+import { DOME_ALT, type SkyGeom } from './sky'
+
+/*
+ * The shape of a cell the dome draws. Above `DOME_ALT` the sky is drawn several times taller than it is wide, for the sky to
+ * fill the screen: that places a cloud, and would draw the cloud itself as an egg, and a deck's gap between two overhead
+ * cells as a box. Such a cell keeps its place and its area on the ground (so the cover stays), takes the proportions it has
+ * to the eye (its disc as it is foreshortened, and its own thickness seen from the side), and as it nears an outline of its
+ * own in place of the circle. Nothing that stands below `DOME_ALT` changes. Pure: the cell (its seed), the sky's geometry.
+ */
+
+const DEG = 180 / Math.PI
+/** A parabolic heap's side, at most half as tall as it is wide: what its thickness adds to the disc seen from below. */
+const SIDE_MAX = 0.5
+/** A cell whose edge is right overhead has no side to the eye: from this share of its radius off it, all of the rule. */
+const OVERHEAD = [1, 1.5] as const
+/** The outline: lobes round it, their size falling as a cloud's perimeter does (Lovejoy 1982, dimension 1.35, so the
+ *  amplitude goes as m^-(2 - 1.35 + 1/2)), and the radius's scatter over all of them. */
+const LOBES = [2, 9] as const, FALL = 1.15, SCATTER = 0.18
+const TABLE = 96
+/** The sites are more regular than chance, so shapes that reach past their circle overlap more: the area that gives the
+ *  cover back (400 drawn lattices each of Ac, As and Cu). */
+const OVERLAP = 1.07
+
+interface Seen { cell: FieldCell; d: number; off: number; east: number; north: number; radial: number; across: number; reach: number; cumulus: boolean; outline: Float32Array }
+
+const offOverhead = (cell: FieldCell, d: number) => smoothstep(OVERHEAD[0], OVERHEAD[1], d / cell.r)
+
+/** How much taller than its true proportions the dome draws a cell: 1 where it stands on the relief. */
+export function stretchOf(cell: FieldCell, heightKm: number, geom: SkyGeom): number {
+  const d = Math.hypot(cell.x, cell.y)
+  if (cell.rMinor !== undefined || d <= cell.r) return 1
+  const near = altitudeOf(heightKm, d - cell.r), far = altitudeOf(heightKm, d + cell.r)
+  if (near <= DOME_ALT) return 1
+  const wide = 2 * Math.atan2(cell.r, Math.hypot(d, heightKm)) * DEG
+  const cos = d / Math.hypot(d, heightKm)
+  const eye = (near - far) / wide + Math.min(SIDE_MAX, cell.vKm / (2 * cell.r)) * cos
+  const pxPerDeg = geom.azimuthRange.period / 360
+  const drawn = (geom.dome(far) - geom.dome(near)) / (2 * Math.asin(cell.r / d) * DEG * pxPerDeg)
+  return 1 + Math.max(0, drawn / eye - 1) * offOverhead(cell, d)
+}
+
+/** 1 / ρ² round the outline (from the radial direction): `amount` of the cell's own lobes, its area the circle's. */
+export function outlineOf(seed: number, amount: number): Float32Array {
+  const lobes = lobesOf(seed)
+  let area = 0
+  for (const v of lobes) area += (1 + amount * v) ** 2 / TABLE
+  return Float32Array.from(lobes, (v) => area / Math.max(0.25, (1 + amount * v) ** 2))
+}
+
+const cache = new Map<number, Float64Array>()
+/** The cell's own lobes round its circle: they stay with it as it drifts. */
+function lobesOf(seed: number): Float64Array {
+  const cached = cache.get(seed)
+  if (cached) return cached
+  const rng = seeded(seed ^ 0x0c10d), rho = new Float64Array(TABLE)
+  let power = 0
+  for (let m = LOBES[0]; m <= LOBES[1]; m++) power += m ** (-2 * FALL) / 2
+  const scale = SCATTER / Math.sqrt(power)
+  for (let m = LOBES[0]; m <= LOBES[1]; m++) {
+    const phase = 2 * Math.PI * rng(), a = scale * m ** -FALL
+    for (let n = 0; n < TABLE; n++) rho[n] += a * Math.cos(2 * Math.PI * m * n / TABLE + phase)
+  }
+  if (cache.size >= 512) cache.clear()
+  cache.set(seed, rho)
+  return rho
+}
+
+/** What the seen shapes change in the sheet's vertical depth at a ground point (km): null where nothing does. */
+export function seenDepth(cells: readonly FieldCell[], heightKm: number, geom: SkyGeom): ((x: number, y: number) => number) | null {
+  const seen: Seen[] = []
+  for (const cell of cells) {
+    const d = Math.hypot(cell.x, cell.y)
+    const near = d <= cell.r ? 90 : altitudeOf(heightKm, d - cell.r)
+    if (cell.rMinor !== undefined || near <= DOME_ALT) continue
+    const root = Math.sqrt(stretchOf(cell, heightKm, geom)), amount = smoothstep(DOME_ALT, 2 * DOME_ALT, near)
+    const outline = outlineOf(cell.seed, amount), size = cell.r * Math.sqrt(1 + (OVERLAP - 1) * amount)
+    const widest = 1 / Math.sqrt(Math.min(...outline))
+    seen.push({ cell, d, off: offOverhead(cell, d), east: d ? cell.x / d : 0, north: d ? cell.y / d : 1, radial: size / root, across: size * root,
+      reach: (size / root + size * root * (1 + cell.r / Math.max(d, cell.r))) ** 2 * widest * widest, outline, cumulus: cell.genus === 'cu' || cell.genus === 'cg' || cell.genus === 'cb' })
+  }
+  if (!seen.length) return null
+  const end = Math.max(...seen.map(({ d, reach }) => d + Math.sqrt(reach))) ** 2
+  return (x, y) => {
+    const squared = x * x + y * y
+    if (squared > end) return 0
+    let sum = 0
+    const range = Math.sqrt(squared)
+    for (const { cell, d, off, east, north, radial, across, reach, cumulus, outline } of seen) {
+      const dx = x - cell.x, dy = y - cell.y, rr = dx * dx + dy * dy
+      if (rr >= reach) continue
+      // Off the zenith the shape lies along the circle of its range, as the dome's azimuth does: none of it drifts outward.
+      const along = dx * east + dy * north, aside = dx * north - dy * east
+      const u = (along + off * (range - d - along)) / radial
+      const v = (off ? aside + off * (d * Math.atan2(aside, d + along) - aside) : aside) / across
+      const uu = u * u + v * v
+      let own = 0
+      if (uu < 4) {
+        const at = (Math.atan2(v, u) / (2 * Math.PI) + 1) * TABLE, n = Math.floor(at), f = at - n
+        own = kernel(cell.tau0, uu * (outline[n % TABLE] * (1 - f) + outline[(n + 1) % TABLE] * f), cumulus)
+      }
+      sum += own - kernel(cell.tau0, rr / (cell.r * cell.r), cumulus)
+    }
+    return sum
+  }
+}
